# Optional: Local AI Insights configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2

# Optional: Supabase backend configuration (RLS disabled — anon key only)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Required for AI Plugin Generator
OPENAI_API_KEY=your_openai_api_key

# Required for automatic GitHub PR creation in the Plugin Generator
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO_OWNER=your_github_username_or_org
GITHUB_REPO_NAME=your_repo_name
